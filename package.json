{
  "name": "cuanto.bio",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "playwright install && svelte-kit sync && lefthook install || echo ''",
    "check": "pnpm check:biome && pnpm check:svelte",
    "check:biome": "biome check --no-errors-on-unmatched --files-ignore-unknown=true",
    "check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "test:unit": "vitest --run",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:pwa",
    "test:integration": "playwright test",
    "test:pwa": "playwright test --config=playwright.pwa.config.ts",
    "gen-icons": "tsx scripts/gen-icons.ts",
    "gen-key": "tsx scripts/gen-key.ts",
    "cap:ios:domains": "tsx scripts/sync-ios-app-bound-domains.ts",
    "cap:sync": "pnpm cap:ios:domains && cap sync",
    "cap:run:ios": "pnpm cap:ios:domains && cap run ios",
    "cap:run:android": "cap run android",
    "cap:open:ios": "pnpm cap:ios:domains && cap sync ios && cap open ios",
    "cap:open:android": "cap sync android && cap open android",
    "migrate:up": "tsx --env-file=.env scripts/migrate.ts up",
    "migrate:down": "tsx --env-file=.env scripts/migrate.ts down",
    "reindex-protocol": "tsx --env-file=.env scripts/reindex-protocol.ts",
    "backfill-surveys": "tsx --env-file=.env scripts/backfill-surveys.ts",
    "stamp-lexicon-migration": "tsx --env-file=.env scripts/stamp-lexicon-migration.ts",
    "test:db:setup": "tsx scripts/setup-test-db.ts",
    "lex:gen": "lex build --out src/lib/lexicons --lexicons ./lexicons --indexFile --clear",
    "psql": "docker compose exec db psql -U cuanto -d cuanto",
    "railway:deploy": "railway deployment up --service app --message \"Last commit: $(git rev-parse HEAD)\"",
    "railway:deploy-info": "railway deployment list --service app --json --limit 1 | jq .[0].meta.cliMessage",
    "railway:migrate:up": "railway ssh --service app -- node --experimental-strip-types scripts/migrate.ts up",
    "railway:migrate:down": "railway ssh --service app -- node --experimental-strip-types scripts/migrate.ts down"
  },
  "devDependencies": {
    "@atproto/jwk-jose": "^0.1.11",
    "@atproto/lex": "latest",
    "@biomejs/biome": "^2.4.11",
    "@capacitor/cli": "^8.4.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.17.0",
    "@playwright/test": "latest",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.58.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/d3-array": "^3.2.2",
    "@types/node": "^20",
    "@types/sanitize-html": "^2.16.1",
    "@types/tar-stream": "^3.1.4",
    "bits-ui": "^2.17.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.5",
    "mode-watcher": "^1.1.0",
    "pino-pretty": "^13.1.3",
    "shadcn-svelte": "^1.2.7",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.6",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "@atproto/common-web": "^0.4.20",
    "@atproto/identity": "^0.4.12",
    "@atproto/lexicon": "^0.6.2",
    "@atproto/oauth-client-node": "^0.3.17",
    "@atproto/syntax": "^0.5.4",
    "@atproto/tap": "^0.2.12",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.2",
    "@capgo/background-geolocation": "^8.3.1",
    "@dagrejs/dagre": "^3.0.0",
    "@fontsource-variable/dynapuff": "^5.2.8",
    "@fontsource-variable/nunito": "^5.2.7",
    "d3-array": "^3.2.4",
    "idb": "^8.0.3",
    "maplibre-gl": "^5.24.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "sanitize-html": "^2.17.4",
    "tar-stream": "^3.2.0",
    "terra-draw": "^1.31.0",
    "terra-draw-maplibre-gl-adapter": "^1.4.1"
  }
}
