{
  "name": "cuanto.bio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "playwright install && svelte-kit sync || echo ''",
    "check": "pnpm check:biome && pnpm check:svelte",
    "check:biome": "biome check --no-errors-on-unmatched --files-ignore-unknown=true",
    "check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "test:unit": "vitest --run",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:integration": "playwright test",
    "gen-key": "tsx scripts/gen-key.ts",
    "migrate:up": "tsx --env-file=.env scripts/migrate.ts up",
    "migrate:down": "tsx --env-file=.env scripts/migrate.ts down",
    "test:db:setup": "tsx scripts/setup-test-db.ts",
    "lex:gen": "lex build --out src/lib/lexicons --lexicons ./lexicons --indexFile --clear",
    "psql": "docker compose exec db psql -U cuanto -d cuanto"
  },
  "devDependencies": {
    "@atproto/jwk-jose": "^0.1.11",
    "@atproto/lex": "latest",
    "@biomejs/biome": "^2.4.11",
    "@fontsource-variable/inter": "^5.2.8",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.8.0",
    "@playwright/test": "latest",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^20",
    "bits-ui": "^2.17.3",
    "clsx": "^2.1.1",
    "pino-pretty": "^13.1.3",
    "shadcn-svelte": "^1.2.7",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "@atproto/lexicon": "^0.6.2",
    "@atproto/oauth-client-node": "^0.3.17",
    "@atproto/tap": "^0.2.12",
    "pino": "^10.3.1",
    "postgres": "^3.4.9"
  }
}
