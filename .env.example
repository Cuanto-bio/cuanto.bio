# Postgres config for Docker
POSTGRES_DB=cuanto
POSTGRES_USER=cuanto
POSTGRES_PASSWORD=cuanto

# Postgres config for the app
DATABASE_URL=postgresql://cuanto:cuanto@localhost:5432/cuanto

# OAuth config
PUBLIC_URL=http://127.0.0.1:5173
PUBLIC_OAUTH_CLIENT_ID=http://localhost

# Required in production (PUBLIC_OAUTH_CLIENT_ID=https://...). Generate with: pnpm gen-key
PRIVATE_OAUTH_KEY=

# Tap config
TAP_ADMIN_PASSWORD=devpassword
TAP_URL=http://localhost:2480
